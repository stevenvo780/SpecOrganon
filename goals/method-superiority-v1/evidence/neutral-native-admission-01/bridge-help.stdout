usage: bridge.py [-h] --provider {gemini,codex} --model MODEL --request
                 REQUEST --output-dir OUTPUT_DIR
                 [--model-catalog MODEL_CATALOG]
                 [--expected-executable-sha256 EXPECTED_EXECUTABLE_SHA256]
                 [--codex-reasoning-effort {low,medium,high,xhigh}]

options:
  -h, --help            show this help message and exit
  --provider {gemini,codex}
  --model MODEL
  --request REQUEST
  --output-dir OUTPUT_DIR
  --model-catalog MODEL_CATALOG
  --expected-executable-sha256 EXPECTED_EXECUTABLE_SHA256
  --codex-reasoning-effort {low,medium,high,xhigh}
