    },
    "a1": {
      "data": {},
      "deps": {
        "p1": 1
      },
      "id": "a1",
      "kind": "actor",
      "text": "El due\u00f1o autoriza el hito local; Codex investiga e implementa; otros agentes revisan evidencia t\u00e9cnica sin editar la soluci\u00f3n; evaluadores reservados observan la entrega. Los actores del campo alimentario quedan fuera de este hito.",
      "version": 1,
      "seq": 2,
      "author": "agent:codex-orchestrator",
      "stale": false,
      "contested": false,
      "issues": [],
