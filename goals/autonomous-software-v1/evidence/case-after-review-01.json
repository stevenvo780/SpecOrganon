      "id": "p1",
      "kind": "problem",
      "text": "Necesitamos una release reproducible del toolkit que permita a agentes completar el m\u00e9todo y entregar software peque\u00f1o con evidencia, documentaci\u00f3n y comparaci\u00f3n prospectiva. El piloto previo produjo buen c\u00f3digo pero no aplicaci\u00f3n completa.",
      "version": 1,
      "seq": 1,
      "author": "agent:codex-orchestrator",
      "stale": false,
      "contested": false,
      "issues": [],
      "approved": false,
