[
  {
    "name": "specorganon",
    "enabled": true,
    "disabled_reason": null,
    "transport": {
      "type": "stdio",
      "command": "/opt/specorganon/venv/bin/organon-mcp",
      "args": [],
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "ORGANON_ROOT": "/workspace"
      },
      "env_vars": [],
      "cwd": "/workspace"
    },
    "startup_timeout_sec": 30.0,
    "tool_timeout_sec": 120.0,
    "auth_status": "unsupported"
  }
]
