mode = 'graph'

    @pytest.mark.parametrize("mode", ["graph", "risk"])
    def test_concurrent_replays_capture_each_core_result(monkeypatch, tmp_path, mode):
        case = proposal(normative=False)
        case["nodes"].append(node("q", "philosophy"))
        raw, _ = initialize(tmp_path, mode, case)
        operations = [[row(1, revision("p"), role="worker-1")],
                      [row(2, revision("q"), role="worker-2")]]
        expected = [kernel.apply_operations(raw, ops, mode=mode) for ops in operations]
        native_run = kernel.core.run
        start = threading.Barrier(2)
        second_entered, first_finished = threading.Event(), threading.Event()
        counter_lock = threading.Lock()
        calls = active = maximum_active = 0
    
        def delayed_run(selected_mode, args):
            nonlocal calls, active, maximum_active
            with counter_lock:
                calls += 1
                index = calls
                active += 1
                maximum_active = max(maximum_active, active)
            try:
                if index == 1:
                    # Without the kernel lock, the second redirect is now active
                    # when this invocation emits its JSON into the wrong stream.
                    second_entered.wait(0.15)
                else:
                    second_entered.set()
                    assert first_finished.wait(2)
                return native_run(selected_mode, args)
            finally:
                with counter_lock:
                    active -= 1
                if index == 1:
                    first_finished.set()
    
        def replay(ops):
            start.wait(timeout=2)
            return kernel.apply_operations(raw, ops, mode=mode)
    
        monkeypatch.setattr(kernel.core, "run", delayed_run)
        stdout, stderr = sys.stdout, sys.stderr
        try:
            with concurrent.futures.ThreadPoolExecutor(max_workers=2) as executor:
                futures = [executor.submit(replay, ops) for ops in operations]
                # Join before reading exceptions so the pre-fix failure also leaves
                # the test runner's global streams restored and evidence readable.
>           observed = [future.result() for future in futures]
